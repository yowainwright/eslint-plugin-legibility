{
  "lockfile": true,
  "targets": [
    {
      "manager": "pnpm",
      "files": [
        "package.json"
      ],
      "mode": "precise",
      "codependencies": [
        { "@eslint/js": "^9.0.0" },
        { "@nubjs/nub": "^0.7.0" },
        { "@types/node": "^26.0.0" },
        { "eslint": "^9.0.0" },
        { "oxlint": "^1.0.0" },
        { "release-it": "^21.0.0" },
        { "typescript": "^6.0.3" },
        { "typescript-eslint": "^8.60.1" }
      ]
    },
    {
      "manager": "github-actions",
      "files": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "mode": "precise"
    },
    {
      "manager": "docker",
      "files": [
        "Dockerfile",
        "Dockerfile.*",
        "**/Dockerfile",
        "**/Dockerfile.*"
      ],
      "ignore": [
        ".git/**",
        ".build/**",
        "dist/**",
        "node_modules/**",
        "tests/**"
      ],
      "mode": "verbose",
      "codependencies": []
    }
  ]
}
